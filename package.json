{
  "name": "odin-db",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @odin-db/desktop tauri dev",
    "build": "pnpm --filter @odin-db/desktop tauri build",
    "bindings": "cargo run --quiet -p odin-desktop --bin gen-bindings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm check:rust",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "test:integration": "cargo test --workspace -- --ignored",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
